# Production recipe: GU_MIX K16 channel-split INT8 + GEG8 fused gate/up epilogue.
# This is the exact env state behind the published result (92.2% LIBERO-10, 461/500 @ 92.4 ms model p50).
# Source this file before launching the server. Semantics per var: docs/recipe.md.
#
# GU_MIX + GEG8 = 13 variables (11 explicit + the server's FORCE_INT8 setdefault made explicit).
# A/B discipline: the server applies FORCE_INT8 via os.environ.setdefault, so a BF16 control arm
# MUST set it to 0 explicitly here (or in the shell) - relying on the default is how a stale INT8
# state leaks into a control arm.

# --- decoder: full INT8 (90 GEMMs) ---
export FVK_PI05_RTX_INT8_DECODER_ONLY=1

# --- encoder: GU_MIX channel split (attention + gate/up INT8 on selected channels) ---
export FVK_PI05_RTX_ENC8_ATTN=1
export FVK_PI05_RTX_ENC8_MLP=1          # enables the mixed gate/up path (GU_MIX core)
export FVK_PI05_RTX_ENC8_DOWN=1
export FVK_PI05_RTX_ENC8_MIX=1
export FVK_PI05_RTX_ENC8_MIX_FILE=${PI05_MIX_SETS:-tools/mix_sets_k16.npz}

# --- GEG8: fused gate/up epilogue kernel (adds -3.2 ms on top of GU_MIX) ---
export FVK_PI05_RTX_ENC8_MIX_GEG8=1

# --- cross-cutting ---
export FLASHRT_PI05_INT8_FAST_QUANT=1
export FVK_PI05_RTX_VEC_ELEMENTWISE=1
export FVK_PI05_RTX_FLOW_START=0.5
export FLASHRT_WS_ALPHA=0.5
export FLASHRT_PI05_EMBED_NP=0

# server-side setdefault made explicit (protects A/B arms from stale env)
export FVK_PI05_RTX_FORCE_INT8=1
