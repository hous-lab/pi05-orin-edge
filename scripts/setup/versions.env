#!/usr/bin/env bash
# Locked platform versions (M0 probe, 2026-09-29). All numbers measured on the
# actual deployment target. See docs/environment.md for the narrative version.

# ---- Deployment target: Jetson AGX Orin 64GB ----
export ORIN_L4T="36.5.0"           # /etc/nv_tegra_release, R36 REV 5.0
export ORIN_JETPACK="6.x"          # 36.5.0 ~= JP6.2.1 family
export ORIN_CUDA="12.6"
export ORIN_TRT_BIN="10.3"
export ORIN_TRT_PY="10.4.0"       # python wheel -- MISMATCH vs trtexec bin, watch build steps
export ORIN_CUDNN="9.3.0"
export ORIN_PYTHON="3.10.12"
export ORIN_TORCH="2.8.0+cu126"   # NVIDIA Jetson system stack, DO NOT touch
export ORIN_SM="8.7"              # Ampere, 16 SM
export ORIN_MEM_GB=64             # LPDDR5X
# Orin spec: 204.8 GB/s peak DRAM BW, 4MB L2, INT8 TC yes, FP8 no
export ORIN_POWER_MODE=MAXN       # jetson_clocks on

# ---- x86 host (RTX 4090 Laptop) ----
export X86_SM="8.9"

# ---- Checkpoint facts (openpi-assets GCS, listed 2026-09-29) ----
export CKPT_ID=pi05_libero
export CKPT_GCS_BASE=https://storage.googleapis.com/openpi-assets/checkpoints
export CKPT_ASSETS_NORM_STATS=assets/physical-intelligence/libero/norm_stats.json

# ---- Reference numbers (NOT our SLA -- different hw/sw stacks) ----
# Jetson Thor tutorial: BF16 PyTorch ~132ms | FP8 TRT ~54ms | FP8+NVFP4 ~49ms
# FlashRT (AGX Orin):   BF16 ~193ms | cache_frames=1 lossless ~124ms
# pi.cpp (AGX Orin):    305.51ms -> 125.99ms (QDQ INT8 + suffix-broadcast-KV)
# APXInf (AGX Orin):    BF16 165.67ms -> 119.05ms w/ action pruning, LIBERO-10 92.0%
